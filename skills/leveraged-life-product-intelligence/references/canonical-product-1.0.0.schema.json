{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leveraged-life-product-intelligence:canonical-product:1.0.0",
  "title": "Leveraged Life Product Intelligence Canonical Product",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_scope", "product", "sources", "evidence", "cases", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_scope": {"const": "product_only"},
    "product": {"$ref": "#/$defs/product"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "provenance": {
      "type": "object",
      "propertyNames": {"pattern": "^/"},
      "additionalProperties": {"$ref": "#/$defs/provenance"}
    },
    "extensions": {"type": "object", "maxProperties": 0, "additionalProperties": false}
  },
  "$defs": {
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nonnegativeDecimal": {
      "oneOf": [
        {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        {"type": "number", "minimum": 0}
      ]
    },
    "signedDecimal": {
      "oneOf": [
        {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        {"type": "number"}
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "name", "insurer", "currency", "product_type"],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "insurer": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "product_type": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string"},
        "participating": {"type": "boolean"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "kind", "document_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["contract", "illustration", "cash_value_table", "rate_table", "structured_input", "synthetic_benchmark"]},
        "version": {"type": "string"},
        "uri": {"type": "string"},
        "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_id", "document_sha256", "page", "raw_text", "content_sha256", "extractor", "confidence"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "locator": {"type": "object"},
        "raw_text": {"type": "string", "maxLength": 4000},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "extractor": {"type": "string", "minLength": 1},
        "extractor_version": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ids", "extractor", "confidence", "status"],
      "properties": {
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "extractor": {"type": "string", "minLength": 1},
        "extractor_version": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["accepted", "needs_review", "rejected"]},
        "raw_value": {},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "basis", "timing", "amount_scale", "premium_cashflows", "scenario_definitions", "projection"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "benchmark_version"],
          "properties": {
            "kind": {"enum": ["standard_benchmark", "document_illustration"]},
            "benchmark_version": {"type": "string", "minLength": 1},
            "pricing_basis_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue_date", "premium_timing", "benefit_timing"],
          "properties": {
            "issue_date": {"type": "string", "format": "date"},
            "premium_timing": {"enum": ["explicit_dates"]},
            "benefit_timing": {"enum": ["projection_date"]}
          }
        },
        "amount_scale": {"const": "currency_unit"},
        "inflation_rate": {"$ref": "#/$defs/signedDecimal"},
        "premium_cashflows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "time_years", "amount"],
            "properties": {
              "date": {"type": "string", "format": "date"},
              "time_years": {"$ref": "#/$defs/nonnegativeDecimal"},
              "amount": {"$ref": "#/$defs/money"}
            }
          }
        },
        "scenario_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "guaranteed"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "guaranteed": {"const": false}
            }
          }
        },
        "projection": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy_year", "date", "time_years", "death_benefit", "cash_surrender_value"],
            "properties": {
              "policy_year": {"type": "integer", "minimum": 1},
              "date": {"type": "string", "format": "date"},
              "time_years": {"$ref": "#/$defs/nonnegativeDecimal"},
              "death_benefit": {"$ref": "#/$defs/benefit"},
              "cash_surrender_value": {"$ref": "#/$defs/benefit"}
            }
          }
        }
      }
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guaranteed", "scenarios"],
      "properties": {
        "guaranteed": {"$ref": "#/$defs/money"},
        "scenarios": {"type": "object", "additionalProperties": {"$ref": "#/$defs/money"}}
      }
    }
  }
}
