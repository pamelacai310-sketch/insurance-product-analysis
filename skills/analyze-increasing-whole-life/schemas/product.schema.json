{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/increasing-whole-life/product.schema.json",
  "title": "Increasing Whole Life Product Input",
  "type": "object",
  "required": ["product", "policy_values"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_mode": {"enum": ["core", "full"]},
    "product": {
      "type": "object",
      "required": ["name", "product_type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "product_type": {"const": "increasing_whole_life"},
        "currency": {"type": ["string", "null"]},
        "entry_age": {"type": ["integer", "null"], "minimum": 0},
        "gender": {"type": ["string", "null"]},
        "underwriting_class": {"type": ["string", "null"]},
        "payment_period_years": {"type": ["integer", "null"], "minimum": 0},
        "premium_frequency": {"type": ["string", "null"]},
        "benefit_option": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "premium_schedule": {
      "type": "object",
      "required": ["annual_amount", "years"],
      "properties": {
        "annual_amount": {"type": "number", "exclusiveMinimum": 0},
        "years": {"type": "integer", "minimum": 1},
        "first_time_years": {"type": "number", "minimum": 0},
        "interval_years": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "premium_cashflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time_years", "amount"],
        "properties": {
          "time_years": {"type": "number", "minimum": 0},
          "amount": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "policy_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["year", "guaranteed_cash_value", "guaranteed_death_benefit"],
        "properties": {
          "year": {"type": "integer", "minimum": 1},
          "guaranteed_cash_value": {"type": "number", "minimum": 0},
          "guaranteed_death_benefit": {"type": "number", "minimum": 0},
          "illustrated_cash_value": {"type": ["number", "null"], "minimum": 0},
          "illustrated_death_benefit": {"type": ["number", "null"], "minimum": 0},
          "source_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "partial_surrender_rule": {"type": ["object", "null"]},
    "policy_loan_rule": {"type": ["object", "null"]},
    "sources": {"type": "object"}
  },
  "oneOf": [
    {"required": ["premium_schedule"], "not": {"required": ["premium_cashflows"]}},
    {"required": ["premium_cashflows"], "not": {"required": ["premium_schedule"]}}
  ],
  "additionalProperties": true
}
