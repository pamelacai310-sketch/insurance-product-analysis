{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:annuity-product-intelligence:1.0.0:semantic-resolution",
  "title": "Schema-Constrained Semantic Exception Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolutions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "target_path", "value", "source_record_id", "candidate_confidence", "rationale"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "target_path": {"type": "string", "pattern": "^/configurations/"},
          "value": {},
          "source_record_id": {"type": "string", "minLength": 1},
          "candidate_confidence": {"const": "medium"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
